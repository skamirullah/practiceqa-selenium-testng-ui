<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Each test method gets its own browser (see DriverManager), so methods can run side by side. -->
<suite name="StayEase UI" parallel="methods" thread-count="3">
  <listeners>
    <listener class-name="com.practiceqa.stayease.listeners.TestListener"/>
  </listeners>
  <test name="Regression">
    <packages>
      <package name="com.practiceqa.stayease.tests"/>
    </packages>
  </test>
</suite>
